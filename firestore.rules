rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSeatId(id) {
      return id is string && id.size() >= 2 && id.size() <= 16 && id.matches('^[A-Z]-[0-9]{2}$');
    }

    function isValidFormat(fmt) {
      return fmt is string && fmt in ['IMAX Laser', 'Dolby Atmos', 'Boutique 2D'];
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'favoriteMovieIds',
          'favoriteTheaterIds',
          'preferredFormat',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'favoriteMovieIds',
          'favoriteTheaterIds',
          'preferredFormat',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 120
        && data.favoriteMovieIds is list
        && data.favoriteMovieIds.size() <= 20
        && (data.favoriteMovieIds.size() == 0 || (data.favoriteMovieIds[0] is string && data.favoriteMovieIds[0].size() <= 64))
        && data.favoriteTheaterIds is list
        && data.favoriteTheaterIds.size() <= 10
        && (data.favoriteTheaterIds.size() == 0 || (data.favoriteTheaterIds[0] is string && data.favoriteTheaterIds[0].size() <= 64))
        && isValidFormat(data.preferredFormat)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBooking(data, userId, bookingId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'confirmationCode',
          'movieId',
          'movieTitle',
          'posterUrl',
          'auditoriumId',
          'auditoriumName',
          'format',
          'showtimeId',
          'dateLabel',
          'time',
          'seatIds',
          'concessionsSummary',
          'customerName',
          'customerEmail',
          'subtotal',
          'bookingFee',
          'total',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'confirmationCode',
          'movieId',
          'movieTitle',
          'posterUrl',
          'auditoriumId',
          'auditoriumName',
          'format',
          'showtimeId',
          'dateLabel',
          'time',
          'seatIds',
          'concessionsSummary',
          'customerName',
          'customerEmail',
          'subtotal',
          'bookingFee',
          'total',
          'createdAt'
        ])
        && data.id is string
        && data.id == bookingId
        && isValidId(data.id)
        && data.userId is string
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.confirmationCode is string
        && data.confirmationCode.size() >= 4
        && data.confirmationCode.size() <= 24
        && data.movieId is string
        && isValidId(data.movieId)
        && data.movieTitle is string
        && data.movieTitle.size() >= 1
        && data.movieTitle.size() <= 120
        && data.posterUrl is string
        && data.posterUrl.size() >= 1
        && data.posterUrl.size() <= 300
        && data.auditoriumId is string
        && isValidId(data.auditoriumId)
        && data.auditoriumName is string
        && data.auditoriumName.size() >= 1
        && data.auditoriumName.size() <= 100
        && isValidFormat(data.format)
        && data.showtimeId is string
        && isValidId(data.showtimeId)
        && data.dateLabel is string
        && data.dateLabel.size() >= 1
        && data.dateLabel.size() <= 40
        && data.time is string
        && data.time.size() >= 1
        && data.time.size() <= 16
        && data.seatIds is list
        && data.seatIds.size() >= 1
        && data.seatIds.size() <= 8
        && data.seatIds[0] is string
        && isValidSeatId(data.seatIds[0])
        && data.concessionsSummary is string
        && data.concessionsSummary.size() <= 400
        && data.customerName is string
        && data.customerName.size() >= 2
        && data.customerName.size() <= 80
        && data.customerEmail is string
        && data.customerEmail.size() >= 3
        && data.customerEmail.size() <= 120
        && data.subtotal is number
        && data.subtotal >= 0
        && data.subtotal <= 10000
        && data.bookingFee is number
        && data.bookingFee >= 0
        && data.bookingFee <= 200
        && data.total is number
        && data.total >= 0
        && data.total <= 10200
        && data.createdAt is timestamp;
    }

    function isValidSeatReservation(data, showtimeId, seatId) {
      return data.keys().hasAll(['showtimeId', 'seatId', 'reservedBy', 'createdAt'])
        && data.keys().hasOnly(['showtimeId', 'seatId', 'reservedBy', 'createdAt'])
        && data.showtimeId is string
        && data.showtimeId == showtimeId
        && isValidId(data.showtimeId)
        && data.seatId is string
        && data.seatId == seatId
        && isValidSeatId(data.seatId)
        && data.reservedBy is string
        && data.reservedBy == request.auth.uid
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId) && isEmailVerified();
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isEmailVerified()
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isEmailVerified()
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredFormat', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['favoriteMovieIds', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['favoriteTheaterIds', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'preferredFormat', 'favoriteMovieIds', 'favoriteTheaterIds', 'updatedAt'])
        );
      allow delete: if false;

      match /bookings/{bookingId} {
        allow get: if isValidId(userId)
          && isValidId(bookingId)
          && isOwner(userId)
          && isEmailVerified()
          && existing().userId == request.auth.uid;
        allow list: if isOwner(userId)
          && isEmailVerified()
          && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(bookingId)
          && isOwner(userId)
          && isEmailVerified()
          && isValidBooking(incoming(), userId, bookingId)
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update, delete: if false;
      }
    }

    match /showtimes/{showtimeId}/reservations/{seatId} {
      allow get: if isValidId(showtimeId) && isValidSeatId(seatId);
      allow list: if isValidId(showtimeId) && resource.data.showtimeId == showtimeId;
      allow create: if isValidId(showtimeId)
        && isValidSeatId(seatId)
        && isEmailVerified()
        && isValidSeatReservation(incoming(), showtimeId, seatId)
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
