{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated customer cinema profile including favorite movies, favorite theaters, and format preference.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the profile owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Customer display name.",
          "minLength": 1,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Customer email address.",
          "minLength": 3,
          "maxLength": 120
        },
        "favoriteMovieIds": {
          "type": "array",
          "description": "List of favorited movie IDs (max 20)."
        },
        "favoriteTheaterIds": {
          "type": "array",
          "description": "List of favorited auditorium/theater IDs (max 10)."
        },
        "preferredFormat": {
          "type": "string",
          "description": "Preferred screening format.",
          "enum": ["IMAX Laser", "Dolby Atmos", "Boutique 2D"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was last updated."
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "favoriteMovieIds",
        "favoriteTheaterIds",
        "preferredFormat",
        "createdAt",
        "updatedAt"
      ]
    },
    "BookingRecord": {
      "title": "BookingRecord",
      "description": "Confirmed cinema ticket booking belonging to a specific user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique booking identifier.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "confirmationCode": {
          "type": "string",
          "description": "Human-readable ticket pass code.",
          "minLength": 4,
          "maxLength": 24
        },
        "movieId": {
          "type": "string",
          "description": "Booked movie ID.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "movieTitle": {
          "type": "string",
          "description": "Booked movie title.",
          "minLength": 1,
          "maxLength": 120
        },
        "posterUrl": {
          "type": "string",
          "description": "Movie poster local path.",
          "minLength": 1,
          "maxLength": 300
        },
        "auditoriumId": {
          "type": "string",
          "description": "Booked auditorium ID.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "auditoriumName": {
          "type": "string",
          "description": "Booked auditorium display name.",
          "minLength": 1,
          "maxLength": 100
        },
        "format": {
          "type": "string",
          "description": "Projection format.",
          "enum": ["IMAX Laser", "Dolby Atmos", "Boutique 2D"]
        },
        "showtimeId": {
          "type": "string",
          "description": "Showtime identifier.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "dateLabel": {
          "type": "string",
          "description": "Show date label.",
          "minLength": 1,
          "maxLength": 40
        },
        "time": {
          "type": "string",
          "description": "Showtime clock string.",
          "minLength": 1,
          "maxLength": 16
        },
        "seatIds": {
          "type": "array",
          "description": "Reserved seat codes (1 to 8 seats)."
        },
        "concessionsSummary": {
          "type": "string",
          "description": "Formatted summary of selected concessions.",
          "minLength": 0,
          "maxLength": 400
        },
        "customerName": {
          "type": "string",
          "description": "Ticket holder name.",
          "minLength": 2,
          "maxLength": 80
        },
        "customerEmail": {
          "type": "string",
          "format": "email",
          "description": "Ticket holder email.",
          "minLength": 3,
          "maxLength": 120
        },
        "subtotal": {
          "type": "number",
          "description": "Seats and concessions subtotal."
        },
        "bookingFee": {
          "type": "number",
          "description": "Ticket booking fee."
        },
        "total": {
          "type": "number",
          "description": "Grand total charged."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of reservation."
        }
      },
      "required": [
        "id",
        "userId",
        "confirmationCode",
        "movieId",
        "movieTitle",
        "posterUrl",
        "auditoriumId",
        "auditoriumName",
        "format",
        "showtimeId",
        "dateLabel",
        "time",
        "seatIds",
        "concessionsSummary",
        "customerName",
        "customerEmail",
        "subtotal",
        "bookingFee",
        "total",
        "createdAt"
      ]
    },
    "SeatReservation": {
      "title": "SeatReservation",
      "description": "Publicly readable occupied seat lock for a specific showtime (contains no PII).",
      "type": "object",
      "properties": {
        "showtimeId": {
          "type": "string",
          "description": "Showtime identifier.",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "seatId": {
          "type": "string",
          "description": "Seat identifier such as E-07.",
          "minLength": 2,
          "maxLength": 16,
          "pattern": "^[A-Z]-[0-9]{2}$"
        },
        "reservedBy": {
          "type": "string",
          "description": "UID of the user who locked the seat.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of lock."
        }
      },
      "required": ["showtimeId", "seatId", "reservedBy", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user cinema profile storing preferences and saved favorite movie/theater IDs."
    },
    "/users/{userId}/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/BookingRecord" },
      "description": "Immutable booking receipts owned by the authenticated user."
    },
    "/showtimes/{showtimeId}/reservations/{seatId}": {
      "schema": { "$ref": "#/entities/SeatReservation" },
      "description": "Seat occupancy records for a showtime so reserved seats appear occupied across sessions."
    }
  }
}
